class Main {
  function void main() {
    var Array a;
    var int i;
    var int n;
    let n = 5;
    let a = Array.new(n);
    let i = 0;
    while (i < n) {
      let a[i] = i * i;
      let i = i + 1;
    }
    let i = 0;
    while (i < n) {
      do Output.printInt(a[i]);
      do Output.printString(" ");
      let i = i + 1;
    }
    do Output.println();
    do Main.triangle(4);
    return;
  }

  function void triangle(int h) {
    var int r;
    var int c;
    let r = 1;
    while (r < (h + 1)) {
      let c = 0;
      while (c < r) {
        do Output.printString("*");
        let c = c + 1;
      }
      do Output.println();
      let r = r + 1;
    }
    return;
  }
}
